import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'package:flutter_image_compress/flutter_image_compress.dart';
import 'package:http/http.dart' as http;
import 'package:shared_preferences/shared_preferences.dart';
import '../models/sale.dart';
import '../models/medicine.dart';
import '../models/chat_message.dart';
import 'excel_import_service.dart';

class AiService {
  final String _openRouterUrl = 'https://openrouter.ai/api/v1/chat/completions';

  static const String _keyApiKey = 'openrouter_api_key';
  static const String _keyModel = 'openrouter_model';

  String _apiKey = '';
  String _selectedModel = 'google/gemini-2.5-flash-pro-exp'; // Default

  // Cache for system prompts to avoid redundant generation
  String? _cachedSystemPrompt;
  int? _cachedMedicineCount;
  int? _cachedSalesCount;

  // Common available models on OpenRouter
  static const List<String> availableModels = [
    // Free Models with Vision/Multimodal Capabilities
    'nvidia/nemotron-nano-12b-v2-vl:free',        // Multimodal vision model
    'hunter/hunter-alpha:free',                   // Long-context reasoning (1M tokens)
    'openrouter/healer-alpha:free',               // Omni-modal model
    'openrouter/free',                            // Auto-selects best free model
    
    // Free Text Models
    'arcee-ai/trinity-large-preview:free',        // Strong reasoning & analysis
    'stepfun/step-3.5-flash:free',                // Fast text processing
    'qwen/qwen3-next-80b-a3b-instruct:free',      // Ultra-long context (262K)
    
    // Your Current Models (Keep for backward compatibility)
    'google/gemini-2.5-flash-pro-exp',
    'google/gemini-pro',
    'anthropic/claude-3-haiku',
    'anthropic/claude-3-sonnet',
    'openai/gpt-3.5-turbo',
    'openai/gpt-4o',
    'meta-llama/llama-3-8b-instruct',
  ];

  String get apiKey => _apiKey;
  String get selectedModel => _selectedModel;
  bool get isConfigured => _apiKey.isNotEmpty;

  /// Select the best model based on request type and image presence
  /// Implements smart routing for sales trend and stock prediction
  String selectBestModel(String query, bool hasImage) {
    final lowerQuery = query.toLowerCase();
    
    // Priority 1: Image analysis (multimodal models)
    if (hasImage) {
      return 'nvidia/nemotron-nano-12b-v2-vl:free'; // Best for OCR and chart analysis
    }
    
    // Priority 2: Stock prediction (needs long context)
    if (lowerQuery.contains('stock') || 
        lowerQuery.contains('reorder') || 
        lowerQuery.contains('predict') || 
        lowerQuery.contains('needs') ||
        lowerQuery.contains('inventory') ||
        lowerQuery.contains('low stock')) {
      return 'hunter/hunter-alpha:free'; // 1M context for predictions
    }
    
    // Priority 3: Sales trend analysis (needs strong reasoning)
    if (lowerQuery.contains('sales') || 
        lowerQuery.contains('trend') || 
        lowerQuery.contains('analysis') || 
        lowerQuery.contains('revenue') ||
        lowerQuery.contains('profit') ||
        lowerQuery.contains('growth')) {
      return 'arcee-ai/trinity-large-preview:free'; // Best reasoning model
    }
    
    // Priority 4: Fast response for simple queries
    return 'openrouter/free'; // Auto-selects fastest available model
  }

  Future<void> loadConfig() async {
    final prefs = await SharedPreferences.getInstance();
    _apiKey = prefs.getString(_keyApiKey) ?? '';
    _selectedModel = prefs.getString(_keyModel) ?? availableModels.first;
  }

  Future<void> saveConfig(String key, String model) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_keyApiKey, key);
    await prefs.setString(_keyModel, model);
    _apiKey = key;
    _selectedModel = model;
  }

  /// Detect time period from user question
  int _detectTimePeriod(String? question) {
    if (question == null) return 30; // Default 30 days
    
    final lowerQuestion = question.toLowerCase();
    
    if (lowerQuestion.contains('week') && !lowerQuestion.contains('month')) {
      return 7; // Last 7 days (week)
    } else if (lowerQuestion.contains('month') && !lowerQuestion.contains('quarter')) {
      return 30; // Last 30 days (month)
    } else if (lowerQuestion.contains('quarter') || lowerQuestion.contains('3 months')) {
      return 90; // Last 90 days (quarter)
    } else if (lowerQuestion.contains('day') || lowerQuestion.contains('daily')) {
      return 7; // Last 7 days
    }
    
    return 30; // Default to 30 days
  }

  /// Generate sales summary for AI prompt
  Map<String, dynamic> _generateSalesSummary({
    required List<Sale> sales,
    required List<Medicine> medicines,
    int salesTrendDays = 30,
  }) {
    final start = DateTime.now().subtract(Duration(days: salesTrendDays));
    final end = DateTime.now();
    
    // Get sales trend (daily data)
    final salesTrend = <DateTime, Map<String, dynamic>>{};
    for (var date = start; date.isBefore(end) || date == end; date = date.add(const Duration(days: 1))) {
      final dayKey = DateTime(date.year, date.month, date.day);
      salesTrend[dayKey] = {'revenue': 0.0, 'unitsSold': 0, 'transactions': 0};
    }
    
    for (final sale in sales) {
      if (sale.isReturn) continue;
      if (sale.createdAt.isBefore(start) || sale.createdAt.isAfter(end)) continue;
      
      final dayKey = DateTime(sale.createdAt.year, sale.createdAt.month, sale.createdAt.day);
      if (salesTrend.containsKey(dayKey)) {
        salesTrend[dayKey]!['revenue'] = (salesTrend[dayKey]!['revenue'] as double) + sale.total;
        salesTrend[dayKey]!['unitsSold'] = (salesTrend[dayKey]!['unitsSold'] as int) + 
            sale.items.fold(0, (sum, item) => sum + item.qty);
        salesTrend[dayKey]!['transactions'] = (salesTrend[dayKey]!['transactions'] as int) + 1;
      }
    }
    
    // Get top 10 medicines by revenue
    final topMedicines = <Map<String, dynamic>>[];
    for (final medicine in medicines) {
      final items = <int>[];
      for (final sale in sales) {
        if (sale.isReturn) continue;
        if (sale.createdAt.isBefore(start) || sale.createdAt.isAfter(end)) continue;
        for (final item in sale.items) {
          if (item.medicineId == medicine.id) {
            items.add(item.qty);
          }
        }
      }
      
      if (items.isEmpty) continue;
      
      final unitsSold = items.fold(0, (sum, qty) => sum + qty);
      // Estimate revenue (approximate using selling price)
      final revenue = medicine.sellingPrice * unitsSold;
      
      topMedicines.add({
        'medicineId': medicine.id,
        'name': medicine.name,
        'category': medicine.category,
        'unitsSold': unitsSold,
        'revenue': revenue,
        'currentStock': medicine.totalStock,
      });
    }
    
    // Sort by revenue
    topMedicines.sort((a, b) => (b['revenue'] as double).compareTo(a['revenue'] as double));
    
    // Get reorder estimates (45-day target, 30-day critical)
    final reorderEstimates = <Map<String, dynamic>>[];
    for (final medicine in medicines) {
      // Calculate daily consumption
      double dailyConsumption = 0;
      int totalUnits = 0;
      for (final sale in sales) {
        if (sale.isReturn) continue;
        if (sale.createdAt.isBefore(start) || sale.createdAt.isAfter(end)) continue;
        for (final item in sale.items) {
          if (item.medicineId == medicine.id) {
            totalUnits += item.qty;
          }
        }
      }
      
      if (totalUnits > 0 && salesTrendDays > 0) {
        dailyConsumption = totalUnits / salesTrendDays;
      }
      
      // Calculate days remaining
      final daysRemaining = dailyConsumption > 0 
          ? medicine.totalStock / dailyConsumption 
          : 999.0;
      
      // Calculate reorder quantity for 45-day target
      final targetStock = dailyConsumption * 45;
      final reorderQty = (targetStock - medicine.totalStock).ceil();
      
      if (reorderQty > 0 || daysRemaining < 45) {
        String urgency;
        if (daysRemaining < 30) {
          urgency = 'critical';
        } else if (daysRemaining < 45) {
          urgency = 'warning';
        } else {
          urgency = 'normal';
        }
        
        reorderEstimates.add({
          'medicineId': medicine.id,
          'name': medicine.name,
          'category': medicine.category,
          'dailyConsumption': dailyConsumption,
          'currentStock': medicine.totalStock,
          'daysRemaining': daysRemaining,
          'reorderQuantity': reorderQty > 0 ? reorderQty : 0,
          'reorderUrgency': urgency,
        });
      }
    }
    
    // Sort by urgency
    final urgencyOrder = {'critical': 0, 'warning': 1, 'normal': 2};
    reorderEstimates.sort((a, b) {
      final urgencyDiff = (urgencyOrder[a['reorderUrgency']] ?? 3) - 
                         (urgencyOrder[b['reorderUrgency']] ?? 3);
      if (urgencyDiff != 0) return urgencyDiff;
      return (a['daysRemaining'] as double).compareTo(b['daysRemaining'] as double);
    });
    
    // Calculate totals first
    double totalRevenue = 0;
    int totalUnitsSold = 0;
    int totalTransactions = 0;
    
    for (final entry in salesTrend.values) {
      totalRevenue += entry['revenue'] as double;
      totalUnitsSold += entry['unitsSold'] as int;
      totalTransactions += entry['transactions'] as int;
    }
    
    // Get recent transactions (anonymized)
    final recentTransactions = <Map<String, dynamic>>[];
    for (final sale in sales) {
      if (sale.isReturn) continue;
      if (sale.createdAt.isBefore(start) || sale.createdAt.isAfter(end)) continue;
      
      recentTransactions.add({
        'id': sale.id,
        'invoiceNo': sale.invoiceNo,
        'patientName': 'Customer ${sale.id % 1000}',
        'total': sale.total,
        'createdAt': sale.createdAt,
        'itemCount': sale.items.length,
        'paymentMethod': sale.paymentMethod,
      });
    }
    
    recentTransactions.sort((a, b) => 
      (b['createdAt'] as DateTime).compareTo(a['createdAt'] as DateTime));
    
    return {
      'salesTrend': salesTrend,
      'topMedicines': topMedicines.take(10).toList(),
      'reorderEstimates': reorderEstimates.take(20).toList(),
      'recentTransactions': recentTransactions.take(10).toList(),
      'summary': {
        'totalRevenue': totalRevenue,
        'totalUnitsSold': totalUnitsSold,
        'totalTransactions': totalTransactions,
        'periodDays': salesTrendDays,
        'minimumStockDays': 45,
      },
    };
  }

  String _buildSystemPrompt(List<Sale> sales, List<Medicine> medicines, {String? userQuestion}) {
    // Check if we can use cached prompt (when data hasn't changed significantly)
    final medicineCount = medicines.length;
    final salesCount = sales.length;
    
    if (_cachedSystemPrompt != null &&
        _cachedMedicineCount == medicineCount &&
        _cachedSalesCount == salesCount) {
      return _cachedSystemPrompt!;
    }
    
    // Determine time period from user question
    int salesTrendDays = _detectTimePeriod(userQuestion);
    
    // Get sales summary for AI prompt
    final salesSummary = _generateSalesSummary(
      sales: sales,
      medicines: medicines,
      salesTrendDays: salesTrendDays,
    );
    
    final summary = salesSummary['summary'] as Map<String, dynamic>;
    final topMedicines = salesSummary['topMedicines'] as List<Map<String, dynamic>>;
    final reorderEstimates = salesSummary['reorderEstimates'] as List<Map<String, dynamic>>;
    final recentTransactions = salesSummary['recentTransactions'] as List<Map<String, dynamic>>;
    final salesTrendData = salesSummary['salesTrend'] as Map<DateTime, Map<String, dynamic>>;
    
    // Get statistics for inventory summary
    final lowStockItems = medicines.where((m) => m.storeStock < 10).toList();
    final lowStockCount = lowStockItems.length;
    final zeroStockItems = medicines.where((m) => m.storeStock == 0).length;
    
    // Sort by stock and take top 15 for detailed list
    final criticalLowStock = medicines
        .where((m) => m.storeStock < 10)
        .toList()
      ..sort((a, b) => a.storeStock.compareTo(b.storeStock));
    final criticalStockList = criticalLowStock.take(15)
        .map((m) => '${m.name} (${m.storeStock})')
        .toList();

    // Calculate category distribution
    final categoryCount = <String, int>{};
    for (final m in medicines) {
      categoryCount[m.category] = (categoryCount[m.category] ?? 0) + 1;
    }
    final topCategories = categoryCount.entries.toList()
      ..sort((a, b) => b.value.compareTo(a.value));
    
    // Format sales trend for prompt
    final trendDays = summary['periodDays'] as int;
    String trendText;
    if (trendDays <= 30) {
      // Show daily data
      final entries = salesTrendData.entries.take(14).map((entry) {
        final date = entry.key;
        final data = entry.value;
        return '${date.year}-${date.month.toString().padLeft(2, '0')}-${date.day.toString().padLeft(2, '0')}: '
            '₹${(data['revenue'] as double).toStringAsFixed(0)} '
            '(${data['unitsSold']} units, ${data['transactions']} transactions)';
      }).join('\n');
      trendText = entries.isNotEmpty ? entries : 'No sales data available';
    } else {
      // Show weekly data (group by week)
      final weeklyData = <String, Map<String, dynamic>>{};
      for (final entry in salesTrendData.entries) {
        final date = entry.key;
        final weekKey = '${date.year}-W${((date.day - 1) ~/ 7 + 1).toString().padLeft(2, '0')}';
        if (!weeklyData.containsKey(weekKey)) {
          weeklyData[weekKey] = {'revenue': 0.0, 'unitsSold': 0, 'transactions': 0};
        }
        weeklyData[weekKey]!['revenue'] = (weeklyData[weekKey]!['revenue'] as double) + (entry.value['revenue'] as double);
        weeklyData[weekKey]!['unitsSold'] = (weeklyData[weekKey]!['unitsSold'] as int) + (entry.value['unitsSold'] as int);
        weeklyData[weekKey]!['transactions'] = (weeklyData[weekKey]!['transactions'] as int) + (entry.value['transactions'] as int);
      }
      trendText = weeklyData.entries.map((entry) {
        return '${entry.key}: ₹${(entry.value['revenue'] as double).toStringAsFixed(0)} '
            '(${entry.value['unitsSold']} units)';
      }).join('\n');
    }

    final prompt = '''
You are an expert pharmacy business analyst AI for the Mediposs system.
Here is the current summary data of the pharmacy:
- Total Transactions: ${summary['totalTransactions']}
- Total Revenue: ₹${(summary['totalRevenue'] as double).toStringAsFixed(2)}
- Total Medicines: ${medicines.length}
- Low Stock: $lowStockCount items ($zeroStockItems with zero stock)
- Top Categories: ${topCategories.take(3).map((e) => '${e.key}(${e.value})').join(', ')}
- Critical Stock (bottom 15): ${criticalStockList.join(', ')}

## SALES TREND (Last ${summary['periodDays']} days)
$trendText

## SALES SUMMARY
- Total Revenue: ₹${(summary['totalRevenue'] as double).toStringAsFixed(2)}
- Total Units Sold: ${summary['totalUnitsSold']}
- Total Transactions: ${summary['totalTransactions']}

### TOP 10 MEDICINES BY REVENUE
${topMedicines.isNotEmpty ? topMedicines.map((m) => '${m['name']} (${m['category']}): ₹${(m['revenue'] as double).toStringAsFixed(2)} revenue, ${m['unitsSold']} units, Stock: ${m['currentStock']}').join('\n') : 'No sales data available'}

### REORDER ESTIMATES (45-day minimum stock)
${reorderEstimates.isNotEmpty ? reorderEstimates.take(5).map((r) => '${r['name']}: ${r['daysRemaining'].toStringAsFixed(0)} days left, reorder ${r['reorderQuantity']} units (${r['reorderUrgency']})').join('\n') : 'No reorder needed'}

### RECENT TRANSACTIONS (Anonymized)
${recentTransactions.isNotEmpty ? recentTransactions.take(10).map((t) => 'Invoice ${t['invoiceNo']}: ₹${(t['total'] as double).toStringAsFixed(2)} (${t['itemCount']} items)').join('\n') : 'No recent transactions'}

You can analyze Excel files uploaded by users to provide insights on inventory, sales data, or any other spreadsheet information.

IMPORTANT: Maintain context throughout the conversation. Reference previous charts, results, and actions when relevant. If the user asks about something mentioned earlier in the chat, refer back to that previous interaction.

Answer the user's question concisely, highlighting key business insights. Format your response in clean Markdown.

CRITICAL INSTRUCTION FOR CHARTS:
If the user explicitly asks for a visual chart, graph, or plot, OR if a visual representation would significantly enhance your answer, you MUST output a JSON block formatted exactly like this:

```chart
{
  "type": "bar", 
  "title": "Chart Title",
  "data": [
    {"label": "Item A", "value": 150},
    {"label": "Item B", "value": 300}
  ]
}
```
Supported types: "bar", "pie", "line", "table".
For line charts, the "value" will be the Y-axis and "label" will be the X-axis label.
For tables, "label" is the first column, "value" is the second column.
Always put the ```chart block on its own lines. Do NOT use this unless visual data is relevant.

BILL/IMAGE ANALYSIS:
If the user sends an image (bill/invoice/prescription), carefully read all text in the image.
Extract: medicine names, quantities, prices, dates, invoice numbers.
Present the extracted data clearly. If it's a purchase bill, suggest stock updates.

WAREHOUSE MODIFICATION ACTIONS:
When the user asks you to update stock, change prices, modify low stock alerts, or process a purchase bill into stock:
You MUST output a ```action block with JSON like this:

```action
{
  "type": "update_medicine",
  "updates": [
    {"name": "Paracetamol 500mg", "field": "storeStock", "value": 100},
    {"name": "Amoxicillin", "field": "lowStockThreshold", "value": 20}
  ]
}
```

Valid fields for update: "storeStock", "mainStock", "lowStockThreshold", "purchasePrice", "sellingPrice".
The "name" should match the medicine name from the catalog as closely as possible.

When the user asks you to ADD a new medicine to the catalog:
You MUST output a ```action block with JSON like this:

```action
{
  "type": "add_medicine",
  "medicine": {
    "name": "New Medicine Name",
    "category": "General",
    "unit": "Pcs",
    "barcode": "",
    "purchasePrice": 10.0,
    "sellingPrice": 20.0,
    "storeStock": 0,
    "mainStock": 0,
    "lowStockThreshold": 10
  }
}
```

When the user asks you to REMOVE or DELETE a medicine from the catalog:
You MUST output a ```action block with JSON like this:

```action
{
  "type": "remove_medicine",
  "medicine": {
    "name": "Exact Medicine Name to Remove"
  }
}
```

CRITICAL INSTRUCTIONS FOR REMOVAL:
- ONLY remove the specific medicine requested by the user
- Do NOT remove any other medicines
- The "name" field must contain ONLY the name of the single medicine to delete
- If the user says "remove salbutamol", the name should be "salbutamol" (or the exact matching name from the catalog)
- NEVER output multiple remove_medicine actions in a single block
- NEVER use wildcards or patterns that could match multiple medicines

Examples:
- User: "Remove salbutamol" → Action: {"type": "remove_medicine", "medicine": {"name": "salbutamol"}}
- User: "Delete all medicines with 0 stock" → You should ask for clarification or list them individually

Always confirm what you're about to change BEFORE outputting the action block.
After a purchase bill analysis, if the user says "update stock", output the action block with the extracted quantities added to current stock.
''';

    // Cache the generated prompt
    _cachedSystemPrompt = prompt;
    _cachedMedicineCount = medicineCount;
    _cachedSalesCount = salesCount;
    
    return prompt;
  }

Future<String> askAi(
    String query,
    List<Sale> sales,
    List<Medicine> medicines,
    List<ChatMessage> conversationHistory,
  ) async {
    if (!isConfigured) {
      return "Error: OpenRouter API Key is not configured. Please set it in Settings.";
    }

    // Smart model selection based on query content
    final bool hasImage = conversationHistory.any((msg) => msg.imagePath != null);
    final String selectedModel = selectBestModel(query, hasImage);

    final systemPrompt = _buildSystemPrompt(sales, medicines, userQuestion: query);

    // Build message list with conversation history
    final messages = <Map<String, String>>[
      {"role": "system", "content": systemPrompt},
    ];

    // Helper to truncate long messages
    String truncateContent(String content, {int maxLength = 500}) {
      if (content.length <= maxLength) return content;
      return '${content.substring(0, maxLength)}...\n[truncated for efficiency]';
    }

    // Add conversation history (limit to last 5 messages to reduce payload)
    final recentHistory = conversationHistory.length > 5 
        ? conversationHistory.sublist(conversationHistory.length - 5)
        : conversationHistory;
    
    for (final msg in recentHistory) {
      // Skip image attachments in history to save tokens
      String content;
      if (msg.imagePath != null) {
        content = '${msg.content}\n[Image attached]';
      } else {
        content = truncateContent(msg.content);
      }
      
      messages.add({
        "role": msg.role == 'user' ? 'user' : 'assistant',
        "content": content,
      });
    }

    // Add current query (truncate if very long)
    messages.add({"role": "user", "content": truncateContent(query, maxLength: 1000)});

    try {
       final res = await http.post(
         Uri.parse(_openRouterUrl),
         headers: {
           'Content-Type': 'application/json',
           'Authorization': 'Bearer $_apiKey',
           'HTTP-Referer': 'https://github.com/mediposs',
           'X-Title': 'Mediposs Analysis',
         },
         body: jsonEncode({
           "model": selectedModel,
           "messages": messages,
         }),
       );

       if (res.statusCode == 200) {
         final data = jsonDecode(res.body);
         return data['choices'][0]['message']['content'] ??
             'No response generated.';
       } else {
         return "API Error: ${res.statusCode} - ${res.body}";
       }
     } catch (e) {
       return "Connection Error: $e";
     }
   }

  /// Stream AI response for better perceived performance
  /// Returns a stream of response chunks
Stream<String> askAiStream({
    required String query,
    required List<Sale> sales,
    required List<Medicine> medicines,
    required List<ChatMessage> conversationHistory,
  }) async* {
    if (!isConfigured) {
      yield "Error: OpenRouter API Key is not configured. Please set it in Settings.";
      return;
    }

    // Smart model selection based on query content
    final bool hasImage = conversationHistory.any((msg) => msg.imagePath != null);
    final String selectedModel = selectBestModel(query, hasImage);

    final systemPrompt = _buildSystemPrompt(sales, medicines, userQuestion: query);

    // Helper to truncate long messages
    String truncateContent(String content, {int maxLength = 500}) {
      if (content.length <= maxLength) return content;
      return '${content.substring(0, maxLength)}...\n[truncated for efficiency]';
    }

    // Build message list with conversation history
    final messages = <Map<String, String>>[
      {"role": "system", "content": systemPrompt},
    ];

    // Add conversation history (limit to last 5 messages)
    final recentHistory = conversationHistory.length > 5
        ? conversationHistory.sublist(conversationHistory.length - 5)
        : conversationHistory;

    for (final msg in recentHistory) {
      final content = msg.imagePath != null
          ? '${msg.content}\n[Image attached]'
          : truncateContent(msg.content);

      messages.add({
        "role": msg.role == 'user' ? 'user' : 'assistant',
        "content": content,
      });
    }

    // Add current query
    messages.add({"role": "user", "content": truncateContent(query, maxLength: 1000)});

    try {
       final request = http.Request('POST', Uri.parse(_openRouterUrl));
       request.headers.addAll({
         'Content-Type': 'application/json',
         'Authorization': 'Bearer $_apiKey',
         'HTTP-Referer': 'https://github.com/mediposs',
         'X-Title': 'Mediposs Analysis',
       });
       request.body = jsonEncode({
         "model": selectedModel,
         "messages": messages,
         "stream": true,
       });

        final response = await request.send();
        
        if (response.statusCode != 200) {
          yield "API Error: ${response.statusCode}";
          return;
        }

        // Process stream
        await for (final chunk in response.stream.transform(utf8.decoder)) {
          // Handle Server-Sent Events format
          final lines = chunk.split('\n');
          for (final line in lines) {
            if (line.startsWith('data: ')) {
              final dataStr = line.substring(6);
              if (dataStr == '[DONE]') break;
              
              try {
                final data = jsonDecode(dataStr);
                final delta = data['choices'][0]['delta'];
                if (delta != null && delta['content'] != null) {
                  yield delta['content'];
                }
              } catch (_) {
                // Skip malformed chunks
              }
            }
          }
        }
      } catch (e) {
        yield "Connection Error: $e";
      }
  }
   }

    // Smart model selection based on query content
    final bool hasImage = conversationHistory.any((msg) => msg.imagePath != null);
    final String selectedModel = selectBestModel(query, hasImage);

    final systemPrompt = _buildSystemPrompt(sales, medicines, userQuestion: query);

    // Helper to truncate long messages
    String truncateContent(String content, {int maxLength = 500}) {
      if (content.length <= maxLength) return content;
      return '${content.substring(0, maxLength)}...\n[truncated for efficiency]';
    }

    // Build message list with conversation history
    final messages = <Map<String, String>>[
      {"role": "system", "content": systemPrompt},
    ];

    // Add conversation history (limit to last 5 messages)
    final recentHistory = conversationHistory.length > 5
        ? conversationHistory.sublist(conversationHistory.length - 5)
        : conversationHistory;

    for (final msg in recentHistory) {
      final content = msg.imagePath != null
          ? '${msg.content}\n[Image attached]'
          : truncateContent(msg.content);

      messages.add({
        "role": msg.role == 'user' ? 'user' : 'assistant',
        "content": content,
      });
    }

    // Add current query
    messages.add({"role": "user", "content": truncateContent(query, maxLength: 1000)});

    try {
       final request = http.Request('POST', Uri.parse(_openRouterUrl));
       request.headers.addAll({
         'Content-Type': 'application/json',
         'Authorization': 'Bearer $_apiKey',
         'HTTP-Referer': 'https://github.com/mediposs',
         'X-Title': 'Mediposs Analysis',
       });
       request.body = jsonEncode({
          "model": selectedModel,
          "messages": messages,
          "stream": true,
        });
     }

    // Add current query
    messages.add({"role": "user", "content": truncateContent(query, maxLength: 1000)});

    try {
      final request = http.Request('POST', Uri.parse(_openRouterUrl));
      request.headers.addAll({
        'Content-Type': 'application/json',
        'Authorization': 'Bearer $_apiKey',
        'HTTP-Referer': 'https://github.com/mediposs',
        'X-Title': 'Mediposs Analysis',
      });
request.body = jsonEncode({
           "model": selectedModel,
           "messages": messages,
         });

      final response = await request.send();
      
      if (response.statusCode != 200) {
        yield "API Error: ${response.statusCode}";
        return;
      }

      // Process stream
      await for (final chunk in response.stream.transform(utf8.decoder)) {
        // Handle Server-Sent Events format
        final lines = chunk.split('\n');
        for (final line in lines) {
          if (line.startsWith('data: ')) {
            final dataStr = line.substring(6);
            if (dataStr == '[DONE]') break;
            
            try {
              final data = jsonDecode(dataStr);
              final delta = data['choices'][0]['delta'];
              if (delta != null && delta['content'] != null) {
                yield delta['content'];
              }
            } catch (_) {
              // Skip malformed chunks
            }
          }
        }
      }
    } catch (e) {
      yield "Connection Error: $e";
    }
  }

  /// Compress image to reduce payload size before sending to AI
  /// Returns base64 encoded compressed image
  Future<String> _compressImageToBase64(String imagePath) async {
    try {
      final imageFile = File(imagePath);
      if (!await imageFile.exists()) {
        return '';
      }

      // Resize image to max 1024px to reduce size
      final compressedFile = await FlutterImageCompress.compressAndGetFile(
        imageFile.path,
        imagePath,
        quality: 80, // 80% quality is good for OCR
        minWidth: 1024,
        minHeight: 1024,
        format: CompressFormat.jpeg,
      );

      if (compressedFile == null) {
        // If compression fails, fall back to original
        final bytes = await imageFile.readAsBytes();
        return base64Encode(bytes);
      }

      final bytes = await compressedFile.readAsBytes();
      return base64Encode(bytes);
    } catch (e) {
      // If any error, fall back to original image
      try {
        final bytes = await File(imagePath).readAsBytes();
        return base64Encode(bytes);
      } catch (_) {
        return '';
      }
    }
  }

  /// Send a message with an attached image (bill photo) for OCR / visual AI
  Future<String> askAiWithImage(
    String query,
    String imagePath,
    List<Sale> sales,
    List<Medicine> medicines,
    List<ChatMessage> conversationHistory,
  ) async {
    if (!isConfigured) {
      return "Error: OpenRouter API Key is not configured. Please set it in Settings.";
    }

    // Smart model selection based on query content
    final bool hasImage = true;
    final String selectedModel = selectBestModel(query, hasImage);

    final systemPrompt = _buildSystemPrompt(sales, medicines, userQuestion: query);

    // Read and compress image, then encode to base64
    final imageFile = File(imagePath);
    if (!await imageFile.exists()) {
      return "Error: Image file not found.";
    }

    final base64Image = await _compressImageToBase64(imagePath);

    // Determine MIME type
    final extension = imagePath.split('.').last.toLowerCase();
    String mimeType;
    switch (extension) {
      case 'png':
        mimeType = 'image/png';
        break;
      case 'jpg':
      case 'jpeg':
        mimeType = 'image/jpeg';
        break;
      case 'webp':
        mimeType = 'image/webp';
        break;
      default:
        mimeType = 'image/jpeg';
    }

    // Build message list with conversation history
    final messages = <Map<String, dynamic>>[
      {"role": "system", "content": systemPrompt},
    ];

    // Helper to truncate long messages
    String truncateContent(String content, {int maxLength = 500}) {
      if (content.length <= maxLength) return content;
      return '${content.substring(0, maxLength)}...\n[truncated for efficiency]';
    }

    // Add conversation history (limit to last 5 messages to reduce payload)
    final recentHistory = conversationHistory.length > 5 
        ? conversationHistory.sublist(conversationHistory.length - 5)
        : conversationHistory;
    
    for (final msg in recentHistory) {
      String content;
      if (msg.imagePath != null) {
        content = '${msg.content}\n[Image attached]';
      } else {
        content = truncateContent(msg.content);
      }
      
      messages.add({
        "role": msg.role == 'user' ? 'user' : 'assistant',
        "content": content,
      });
    }

    // Add current query with image
    messages.add({
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": query.isEmpty
              ? "Please analyze this bill/invoice image. Extract all medicine names, quantities, and prices."
              : query,
        },
        {
          "type": "image_url",
          "image_url": {"url": "data:$mimeType;base64,$base64Image"},
        },
      ],
    });

try {
       final res = await http.post(
         Uri.parse(_openRouterUrl),
         headers: {
           'Content-Type': 'application/json',
           'Authorization': 'Bearer $_apiKey',
           'HTTP-Referer': 'https://github.com/mediposs',
           'X-Title': 'Mediposs Analysis',
         },
         body: jsonEncode({
           "model": selectedModel,
           "messages": messages,
         }),
       );

       if (res.statusCode == 200) {
        final data = jsonDecode(res.body);
        return data['choices'][0]['message']['content'] ??
            'No response generated.';
      } else {
        return "API Error: ${res.statusCode} - ${res.body}";
      }
    } catch (e) {
      return "Connection Error: $e";
    }
  }

  /// Analyze an Excel file with AI
  Future<String> analyzeExcel(
    String query,
    File excelFile,
    List<Sale> sales,
    List<Medicine> medicines,
    List<ChatMessage> conversationHistory,
  ) async {
    if (!isConfigured) {
      return "Error: OpenRouter API Key is not configured. Please set it in Settings.";
    }

    // Decode Excel file to text
    final excelText = await ExcelImportService.decodeExcelToText(excelFile);
    
    if (excelText.startsWith('Error:')) {
      return excelText;
    }

    // Smart model selection based on query content
    final bool hasImage = false;
    final String selectedModel = selectBestModel(query, hasImage);

    final systemPrompt = _buildSystemPrompt(sales, medicines, userQuestion: query);

    // Build message list with conversation history
    final messages = <Map<String, String>>[
      {"role": "system", "content": systemPrompt},
    ];

    // Add conversation history (limit to last 10 messages)
    final recentHistory = conversationHistory.length > 10 
        ? conversationHistory.sublist(conversationHistory.length - 10)
        : conversationHistory;
    
    for (final msg in recentHistory) {
      final content = msg.imagePath != null 
          ? '${msg.content}\n[Image attached]'
          : msg.content;
      
      messages.add({
        "role": msg.role == 'user' ? 'user' : 'assistant',
        "content": content,
      });
    }

    // Add Excel analysis request
    final excelAnalysisPrompt = '''
Analyze the following Excel file data:

$excelText

User query: $query

Please provide insights and analysis based on the Excel data and the user's query.
''';

    messages.add({"role": "user", "content": excelAnalysisPrompt});

    try {
      final res = await http.post(
        Uri.parse(_openRouterUrl),
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer $_apiKey',
          'HTTP-Referer': 'https://github.com/mediposs',
          'X-Title': 'Mediposs Analysis',
        },
        body: jsonEncode({
          "model": _selectedModel,
          "messages": messages,
        }),
      );

      if (res.statusCode == 200) {
        final data = jsonDecode(res.body);
        return data['choices'][0]['message']['content'] ??
            'No response generated.';
      } else {
        return "API Error: ${res.statusCode} - ${res.body}";
      }
    } catch (e) {
      return "Connection Error: $e";
    }
  }
}
