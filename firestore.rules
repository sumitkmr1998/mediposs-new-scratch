rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Security rules for licenses activation
    match /licenses/{licenseId} {
      // Clients can read the license to check validity
      allow read: if true;
      
      // Clients can only update if:
      // 1. The license is NOT yet used (isUsed == false)
      // 2. The client sets isUsed to true
      // 3. The client does not alter the tier
      // 4. The client does not alter durationDays
      allow update: if request.resource.data.isUsed == true 
                    && resource.data.isUsed == false
                    && request.resource.data.tier == resource.data.tier
                    && request.resource.data.durationDays == resource.data.durationDays;
                    
      // Client cannot create or delete licenses
      allow create, delete: if false;
    }
    
    // Security rules for payment and config settings
    match /config/payment_settings {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Default rule for all other shop sync collections
    match /shops/{shopId}/{document=**} {
      // Allows sync collections read/write since users need to sync their shop partitions.
      // In a strict environment, you can restrict read/write to authenticated shop users.
      allow read, write: if true;
    }
  }
}
